    {
      "id": "text_32",
      "text": "Evidence-first interface review",
      "bbox": {
        "x": 0.335417,
        "y": 0.253333,
        "width": 0.444444,
        "height": 0.042222
      }
    },
    {
      "id": "text_33",
      "text": "A review of how teams inspect, compare, and decide from visual evidence without asking a model to invent structure.",
      "bbox": {
        "x": 0.335417,
        "y": 0.313333,
        "width": 0.444444,
        "height": 0.058646
      }
    },
    {
      "id": "text_34",
      "text": "Customer problem",
      "bbox": {
        "x": 0.335417,
        "y": 0.400868,
        "width": 0.444444,
        "height": 0.024444
      }
    },
    {
      "id": "text_35",
      "text": "Product teams can capture screenshots faster than they can agree on what the screenshot proves. Reviews drift into subjective descriptions, and the evidence trail is lost between design, engineering, and research.",
      "bbox": {
        "x": 0.335417,
        "y": 0.44283,
        "width": 0.444444,
        "height": 0.071458
      }
    },
    {
      "id": "text_36",
      "text": "Measure the observable facts first. Keep every inference editable and visibly uncertain.",
      "bbox": {
        "x": 0.335417,
        "y": 0.534288,
        "width": 0.444444,
        "height": 0.04
      }
    },
    {
      "id": "text_37",
      "text": "Evidence collected",
      "bbox": {
        "x": 0.335417,
        "y": 0.603177,
        "width": 0.444444,
        "height": 0.024444
      }
    },
