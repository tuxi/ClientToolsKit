      }
    },
    {
      "id": "text_24",
      "text": "Cloudbase evaluation workspace terms",
      "bbox": {
        "x": 0.395139,
        "y": 0.185278,
        "width": 0.541667,
        "height": 0.036667000000000005
      }
    },
    {
      "id": "text_25",
      "text": "Last updated November 1, 2026 · Effective immediately for new evaluations",
      "bbox": {
        "x": 0.395139,
        "y": 0.242778,
        "width": 0.541667,
        "height": 0.01222200000000001
      }
    },
    {
      "id": "text_26",
      "text": "This document contains intentionally small body text to exercise OCR under realistic dense-reading conditions.",
      "bbox": {
        "x": 0.395139,
        "y": 0.272778,
        "width": 0.541667,
        "height": 0.034443999999999975
      }
    },
    {
      "id": "text_27",
      "text": "1. Scope and acceptance",
      "bbox": {
        "x": 0.395139,
        "y": 0.333889,
        "width": 0.541667,
        "height": 0.020000000000000018
      }
    },
    {
      "id": "text_28",
      "text": "These terms govern access to the Cloudbase evaluation workspace and any related documentation, sample data, or benchmark artifacts made available to the customer. By accessing the workspace, the customer accepts these terms on behalf of the organization identified in the order form.",
      "bbox": {
        "x": 0.395139,
        "y": 0.362778,
        "width": 0.541667,
        "height": 0.03628500000000001
      }
    },
    {
      "id": "text_29",
      "text": "2. Evaluation license",
      "bbox": {
        "x": 0.395139,
        "y": 0.425729,
        "width": 0.541667,
        "height": 0.020000000000000018
      }
    },
    {
      "id": "text_30",
      "text": "Cloudbase grants a limited, non-exclusive, non-transferable license to use the evaluation workspace solely for internal testing, quality assessment, and procurement review during the evaluation period. The customer may not redistribute, sublicense, or use the workspace to provide a competing service.",
      "bbox": {
        "x": 0.395139,
        "y": 0.454618,
        "width": 0.541667,
        "height": 0.03628500000000001
      }
    },
    {
      "id": "text_31",
      "text": "3. Data handling",
      "bbox": {
        "x": 0.395139,
        "y": 0.517569,
        "width": 0.541667,
        "height": 0.020000000000000018
      }
    },
    {
      "id": "text_32",
      "text": "Customer content remains the property of the customer. Cloudbase processes customer content only to provide the evaluation workspace, maintain security, and diagnose failures. Benchmark images and ground-truth annotations supplied by the customer must not contain sensitive personal information unless a separate data processing addendum is in effect.",
      "bbox": {
        "x": 0.395139,
        "y": 0.546458,
        "width": 0.541667,
        "height": 0.054427
      }
    },
    {
      "id": "text_33",
      "text": "4. Restrictions",
      "bbox": {
        "x": 0.395139,
        "y": 0.627552,
        "width": 0.541667,
        "height": 0.020000000000000018
      }
    },
    {
      "id": "text_34",
      "text": "The customer may not reverse engineer the service, bypass usage limits, conduct load testing without written approval, or attempt to access another customer’s data. Outputs generated during evaluation are provided for internal review and may not be represented as production commitments.",
      "bbox": {
        "x": 0.395139,
        "y": 0.656441,
        "width": 0.541667,
        "height": 0.03628500000000001
      }
    },
    {
      "id": "text_35",
      "text": "5. Disclaimer",
      "bbox": {
        "x": 0.395139,
        "y": 0.719392,
        "width": 0.541667,
        "height": 0.020000000000000018
      }
    },
    {
      "id": "text_36",
      "text": "The evaluation workspace is provided as is. Cloudbase disclaims all warranties, whether express, implied, or statutory, including merchantability, fitness for a particular purpose, and non-infringement. The customer assumes all risks associated with use of the workspace.",
      "bbox": {
        "x": 0.395139,
        "y": 0.748281,
        "width": 0.541667,
        "height": 0.03628500000000001
      }
    }
