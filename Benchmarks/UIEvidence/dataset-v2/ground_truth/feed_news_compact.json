        "height": 0.014443999999999999
      }
    },
    {
      "id": "text_17",
      "text": "What matters today",
      "bbox": {
        "x": 0.183333,
        "y": 0.134444,
        "width": 0.24147099999999996,
        "height": 0.037778000000000006
      }
    },
    {
      "id": "text_18",
      "text": "Curated reporting from 24 newsrooms, updated at 08:30.",
      "bbox": {
        "x": 0.183333,
        "y": 0.18,
        "width": 0.24147099999999996,
        "height": 0.017777999999999988
      }
    },
    {
      "id": "text_19",
      "text": "For you",
      "bbox": {
        "x": 0.821387,
