      "bbox": {
        "x": 0.700825,
        "y": 0.658663,
        "width": 0.03510199999999997,
        "height": 0.01333300000000004
      }
    },
    {
      "id": "text_38",
      "text": "Culture",
      "bbox": {
        "x": 0.700825,
        "y": 0.714219,
        "width": 0.039551,
        "height": 0.01333300000000004
      }
    },
    {
      "id": "text_39",
      "text": "Independent cinemas test a shared membership model",
      "bbox": {
        "x": 0.700825,
        "y": 0.734219,
        "width": 0.272081,
        "height": 0.018766999999999978
      }
    },
