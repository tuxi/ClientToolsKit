        "height": 0.014444000000000012
      }
    },
    {
      "id": "text_32",
      "text": "Evidence-first interface review",
      "bbox": {
        "x": 0.335417,
        "y": 0.253333,
        "width": 0.444444,
        "height": 0.04222199999999998
      }
    },
    {
      "id": "text_33",
      "text": "A review of how teams inspect, compare, and decide from visual evidence without asking a model to invent structure.",
      "bbox": {
        "x": 0.335417,
        "y": 0.313333,
        "width": 0.444444,
        "height": 0.058645999999999976
      }
    },
    {
      "id": "text_34",
      "text": "Customer problem",
      "bbox": {
        "x": 0.335417,
        "y": 0.400868,
        "width": 0.444444,
        "height": 0.02444400000000002
      }
    },
    {
      "id": "text_35",
      "text": "Product teams can capture screenshots faster than they can agree on what the screenshot proves. Reviews drift into subjective descriptions, and the evidence trail is lost between design, engineering, and research.",
      "bbox": {
        "x": 0.335417,
        "y": 0.44283,
        "width": 0.444444,
        "height": 0.07145799999999997
      }
    },
    {
      "id": "text_36",
      "text": "Measure the observable facts first. Keep every inference editable and visibly uncertain.",
      "bbox": {
        "x": 0.335417,
        "y": 0.534288,
        "width": 0.444444,
        "height": 0.040000000000000036
      }
    },
    {
      "id": "text_37",
      "text": "Evidence collected",
      "bbox": {
        "x": 0.335417,
        "y": 0.603177,
        "width": 0.444444,
        "height": 0.02444400000000002
      }
    },
    {
      "id": "text_38",
      "text": "28 representative interface states",
      "bbox": {
        "x": 0.363194,
        "y": 0.645399,
        "width": 0.416667,
        "height": 0.023819000000000035
      }
    },
    {
      "id": "text_39",
      "text": "Manual OCR and geometry labels",
      "bbox": {
        "x": 0.363194,
        "y": 0.669219,
        "width": 0.416667,
        "height": 0.023819000000000035
      }
    },
    {
